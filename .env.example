# App
APP_NAME=WiFi Billing System
APP_ENV=production
DEBUG=false

# Database
DATABASE_URL=postgresql://zealnet:zealnet@db:5432/wifi_billing

# JWT
# Generate securely via: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# M-Pesa Daraja
# IMPORTANT: Use production credentials for production!
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-domain.com/api/v1/webhooks/daraja
DARAJA_ENVIRONMENT=production

# MikroTik
MIKROTIK_HOST=
MIKROTIK_PORT=80
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=

# Security
FERNET_SECRET_KEY=

# Redis background queue
REDIS_URL=redis://redis:6379/0

# RADIUS
RADIUS_COA_SECRET=testing123

# CORS Config (JSON array format)
ALLOWED_ORIGINS=["*"]

# WireGuard VPN Settings
WIREGUARD_SERVER_PUBLIC_KEY=
WIREGUARD_ENDPOINT=102.219.208.5:51820
MOCK_WIREGUARD=true

# KRA eTIMS Integration
KRA_ETIMS_BASE_URL=https://etims-api-sbx.kra.go.ke
KRA_ETIMS_USERNAME=
KRA_ETIMS_PASSWORD=
KRA_ETIMS_MOCK=true

# Africa's Talking SMS Integration
AT_USERNAME=sandbox
AT_API_KEY=


